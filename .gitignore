cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs and databases
*.log
*.sql
*.sqlite

# Environment variables
.env
.venv

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook
.ipynb_checkpoints

# Uploads
uploads/
assets/screenshots/*.png
assets/screenshots/*.jpg

# Local config
configs/local_config.yaml

# OS
Thumbs.db

# macOS
._*
.Spotlight-V100
.Trashes
EOF